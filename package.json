{
  "name": "vermillion",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "dev": "pnpm --filter @vermillion/desktop dev",
    "start": "pnpm --filter @vermillion/desktop start",
    "prepare:worktree": "node scripts/prepare-worktree.mjs",
    "package": "pnpm -r --workspace-concurrency=1 build && node ./scripts/package-unpack.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "tsx": "^4.20.6",
    "typescript": "^5.8.0",
    "vitest": "^3.2.4"
  }
}
