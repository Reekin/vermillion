[Unit]
Description=Vermillion remote FRP transport
After=network-online.target
Wants=network-online.target

[Service]
User=vermillion-frps
Group=vermillion-frps
ExecStart=/opt/vermillion-remote/frps -c /etc/vermillion-remote/frps.toml
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
