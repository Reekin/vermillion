[Unit]
Description=Vermillion remote HTTPS
After=network-online.target
Wants=network-online.target

[Service]
User=vermillion-caddy
Group=vermillion-caddy
Environment=XDG_DATA_HOME=/var/lib/vermillion-caddy
Environment=XDG_CONFIG_HOME=/var/lib/vermillion-caddy
ExecStart=/opt/vermillion-remote/caddy run --config /etc/vermillion-remote/Caddyfile --adapter caddyfile
Restart=on-failure
RestartSec=5
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/vermillion-caddy
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
UMask=0077

[Install]
WantedBy=multi-user.target
