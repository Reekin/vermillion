{
  "name": "@vermillion/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "pnpm exec tsc -b tsconfig.json --pretty false && pnpm exec node ./scripts/build-electron.mjs && pnpm exec vite build",
    "dev": "node scripts/dev-electron.mjs",
    "dev:web": "pnpm exec vite --host 127.0.0.1 --port 4193",
    "preview": "pnpm exec vite preview --host 127.0.0.1 --port 4193",
    "start": "pnpm exec electron ./dist-electron/main.js",
    "typecheck": "pnpm exec tsc -p tsconfig.json --noEmit",
    "test": "pnpm exec vitest run",
    "lint": "pnpm exec tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vermillion/adapters": "workspace:*",
    "@vermillion/core": "workspace:*",
    "@vermillion/desktop-server": "workspace:*",
    "@vermillion/shared": "workspace:*",
    "d3-hierarchy": "^3.1.2",
    "mermaid": "^11.14.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "xterm": "^5.3.0",
    "@vermillion/workbench": "workspace:*",
    "@base-ui/react": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.544.0",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/d3-hierarchy": "^3.1.7",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.0.2",
    "electron": "^37.2.6",
    "esbuild": "^0.25.9",
    "vite": "^7.1.5",
    "tailwindcss": "^4.1.13",
    "@tailwindcss/vite": "^4.1.13"
  }
}
