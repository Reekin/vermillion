{
  "name": "@vermillion/workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "build": "pnpm exec tsc -b tsconfig.json",
    "typecheck": "pnpm exec tsc -b tsconfig.json --pretty false && pnpm exec tsc -p tsconfig.test.json --pretty false",
    "test": "pnpm run test:standard && pnpm run test:git",
    "test:standard": "pnpm exec vitest run",
    "test:git": "node tests/run-git-tests.mjs",
    "test:semantic": "pnpm exec vitest run --config vitest.semantic.config.ts",
    "lint": "pnpm exec tsc -b tsconfig.json --pretty false"
  },
  "dependencies": {
    "@vermillion/shared": "workspace:*",
    "@vscode/ripgrep": "^1.15.14",
    "zod": "^3.25.76"
  },
  "bin": {
    "vermillion": "./bin/vermillion.mjs"
  }
}
